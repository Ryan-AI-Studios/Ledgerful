new file mode 100644
index 0000000..0cf374b
--- /dev/null
+++ b/src/commands/bench_memory_attribution.rs
@@ -0,0 +1,293 @@
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::ffi::OsStr;
+use std::mem::size_of_val;
+use std::os::windows::io::{FromRawHandle, OwnedHandle};
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+use sysinfo::{Pid, System};
+use windows_sys::Win32::Foundation::FILETIME;
+use windows_sys::Win32::System::ProcessStatus::{
+    K32GetProcessMemoryInfo, PROCESS_MEMORY_COUNTERS_EX,
+};
+use windows_sys::Win32::System::Threading::{
+    GetProcessTimes, OpenProcess, PROCESS_QUERY_LIMITED_INFORMATION,
+};
+
+const FILETIME_UNIX_EPOCH: u64 = 116_444_736_000_000_000;
+const FILETIME_TICKS_PER_SECOND: u64 = 10_000_000;
+type NativeReading = (u64, Option<(u64, u64)>);
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct Peak {
+    utc_unix_ms: u64,
+    nonzero_tick: u64,
+    root_pid: u32,
+    root_creation_filetime: Option<u64>,
+    sampled_tree_working_set_bytes: u64,
+    unattributed_working_set_bytes: u64,
+    missed_reads: u64,
+    rejected_identity: u64,
+    pub(super) attribution_wall_us: u64,
+    processes: Vec<Row>,
+}
+
+#[derive(Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Row {
+    pid: u32,
+    parent_pid: u32,
+    creation_filetime: u64,
+    parent_creation_filetime: u64,
+    image: String,
+    sampled_working_set_bytes: u64,
+    reread_working_set_bytes: u64,
+    reread_private_commit_bytes: u64,
+}
+
+pub(super) struct Probe {
+    root: u32,
+    creation: Option<u64>,
+}
+
+impl Probe {
+    pub(super) fn new(root: u32) -> Self {
+        Self {
+            root,
+            creation: read(root, false).map(|(creation, _)| creation),
+        }
+    }
+
+    pub(super) fn capture(
+        &self,
+        system: &System,
+        rows: &[(u32, Option<u32>, u64)],
+        total: u64,
+        nonzero_tick: u64,
+    ) -> Peak {
+        self.capture_with(
+            rows,
+            total,
+            nonzero_tick,
+            |pid| {
+                system
+                    .process(Pid::from_u32(pid))
+                    .map(|process| (process.start_time(), process.name()))
+            },
+            read,
+        )
+    }
+
+    fn capture_with<'a>(
+        &self,
+        rows: &[(u32, Option<u32>, u64)],
+        total: u64,
+        nonzero_tick: u64,
+        snapshot: impl Fn(u32) -> Option<(u64, &'a OsStr)>,
+        reread: impl Fn(u32, bool) -> Option<NativeReading>,
+    ) -> Peak {
+        let started = Instant::now();
+        let mut peak = Peak {
+            utc_unix_ms: SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_millis() as u64,
+            nonzero_tick,
+            root_pid: self.root,
+            root_creation_filetime: self.creation,
+            sampled_tree_working_set_bytes: total,
+            unattributed_working_set_bytes: total,
+            missed_reads: 0,
+            rejected_identity: 0,
+            attribution_wall_us: 0,
+            processes: Vec::new(),
+        };
+        let mut verified = BTreeMap::new();
+        if let Some((creation, _)) = reread(self.root, false)
+            && Some(creation) == self.creation
+        {
+            verified.insert(self.root, creation);
+        } else {
+            peak.missed_reads += 1;
+        }
+
+        super::visit_tree(rows, self.root, |pid, parent_pid, sampled| {
+            let Some(&parent_creation) = verified.get(&parent_pid) else {
+                peak.rejected_identity += 1;
+                return;
+            };
+            let Some((snapshot_start, image)) = snapshot(pid) else {
+                peak.missed_reads += 1;
+                return;
+            };
+            let Some((creation, Some((working_set, private_commit)))) = reread(pid, true) else {
+                peak.missed_reads += 1;
+                return;
+            };
+            if !identity_matches(creation, parent_creation, snapshot_start) {
+                peak.rejected_identity += 1;
+                return;
+            }
+            verified.insert(pid, creation);
+            peak.unattributed_working_set_bytes -= sampled;
+            peak.processes.push(Row {
+                pid,
+                parent_pid,
+                creation_filetime: creation,
+                parent_creation_filetime: parent_creation,
+                image: image
+                    .to_string_lossy()
+                    .chars()
+                    .filter(|c| c.is_ascii_alphanumeric() || "._-".contains(*c))
+                    .take(80)
+                    .collect(),
+                sampled_working_set_bytes: sampled,
+                reread_working_set_bytes: working_set,
+                reread_private_commit_bytes: private_commit,
+            });
+        });
+        peak.processes.sort_by_key(|row| row.pid);
+        peak.attribution_wall_us = started.elapsed().as_micros() as u64;
+        peak
+    }
+}
+
+fn identity_matches(creation: u64, parent_creation: u64, snapshot_start: u64) -> bool {
+    creation >= parent_creation
+        && creation
+            .checked_sub(FILETIME_UNIX_EPOCH)
+            .is_some_and(|ticks| ticks / FILETIME_TICKS_PER_SECOND == snapshot_start)
+}
+
+fn read(pid: u32, memory: bool) -> Option<NativeReading> {
+    // SAFETY: the PID is a snapshot candidate. A non-null handle transfers to
+    // OwnedHandle and all output buffers are initialized and correctly sized.
+    unsafe {
+        let raw = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid);
+        if raw.is_null() {
+            return None;
+        }
+        let _handle = OwnedHandle::from_raw_handle(raw);
+        let mut creation = FILETIME::default();
+        let mut exit = FILETIME::default();
+        let mut kernel = FILETIME::default();
+        let mut user = FILETIME::default();
+        if GetProcessTimes(raw, &mut creation, &mut exit, &mut kernel, &mut user) == 0 {
+            return None;
+        }
+        let creation =
+            (u64::from(creation.dwHighDateTime) << 32) | u64::from(creation.dwLowDateTime);
+        if !memory {
+            return Some((creation, None));
+        }
+        let mut counters = PROCESS_MEMORY_COUNTERS_EX::default();
+        let length = size_of_val(&counters) as u32;
+        counters.cb = length;
+        if K32GetProcessMemoryInfo(
+            raw,
+            (&mut counters as *mut PROCESS_MEMORY_COUNTERS_EX).cast(),
+            length,
+        ) == 0
+        {
+            return None;
+        }
+        Some((
+            creation,
+            Some((counters.WorkingSetSize as u64, counters.PrivateUsage as u64)),
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn peak_reconciles_original_samples_after_failed_rereads() {
+        let first = FILETIME_UNIX_EPOCH + 10 * FILETIME_TICKS_PER_SECOND;
+        let probe = Probe {
+            root: 1,
+            creation: Some(first),
+        };
+        let rows = [
+            (1, None, 999),
+            (2, Some(1), 10),
+            (3, Some(2), 20),
+            (4, Some(1), 40),
+            (5, Some(4), 80),
+            (6, Some(1), 160),
+            (7, Some(6), 320),
+        ];
+        let total = super::super::tree_rss(&rows, 1);
+        let peak = probe.capture_with(
+            &rows,
+            total,
+            3,
+            |_| Some((10, OsStr::new("test.exe"))),
+            |pid, memory| match (pid, memory) {
+                (1, false) => Some((first, None)),
+                (2, true) => Some((first + 2, Some((1000, 2000)))),
+                (3, true) => Some((first + 3, Some((2000, 4000)))),
+                (4, true) => None,
+                (6, true) => Some((first - 1, Some((4000, 8000)))),
+                _ => panic!("unexpected reread of PID {pid}"),
+            },
+        );
+        let receipt = serde_json::to_value(peak).expect("serializable peak receipt");
+        assert_eq!(receipt["nonzeroTick"], 3);
+        assert_eq!(receipt["sampledTreeWorkingSetBytes"], 630);
+        assert_eq!(receipt["unattributedWorkingSetBytes"], 600);
+        assert_eq!(receipt["missedReads"], 1);
+        assert_eq!(receipt["rejectedIdentity"], 3);
+        let processes = receipt["processes"].as_array().expect("process rows");
+        assert_eq!(processes.len(), 2);
+        assert_eq!(processes[0]["pid"], 2);
+        assert_eq!(processes[0]["parentPid"], 1);
+        assert_eq!(processes[0]["sampledWorkingSetBytes"], 10);
+        assert_eq!(processes[0]["rereadWorkingSetBytes"], 1000);
+        assert_eq!(processes[1]["pid"], 3);
+        assert_eq!(processes[1]["parentPid"], 2);
+        assert_eq!(processes[1]["sampledWorkingSetBytes"], 20);
+        assert_eq!(processes[1]["rereadWorkingSetBytes"], 2000);
+        assert_eq!(processes[1]["parentCreationFiletime"], first + 2);
+        let attributed: u64 = processes
+            .iter()
+            .map(|row| row["sampledWorkingSetBytes"].as_u64().unwrap())
+            .sum();
+        assert_eq!(
+            attributed + receipt["unattributedWorkingSetBytes"].as_u64().unwrap(),
+            total
+        );
+    }
+
+    #[test]
+    fn rejects_reused_pid_with_incompatible_snapshot_or_parent() {
+        let first = FILETIME_UNIX_EPOCH + 10 * FILETIME_TICKS_PER_SECOND;
+        assert!(identity_matches(first + 1, first, 10));
+        assert!(!identity_matches(first, first + 1, 10));
+        assert!(!identity_matches(
+            first + FILETIME_TICKS_PER_SECOND,
+            first,
+            10
+        ));
+    }
+
+    #[test]
+    fn reads_known_touched_allocation_and_detects_missing_pid() {
+        let pid = std::process::id();
+        let (creation, Some((_, before))) = read(pid, true).expect("initial counters") else {
+            panic!("missing counters")
+        };
+        let allocation = vec![0xA5_u8; 32 * 1024 * 1024];
+        std::hint::black_box(&allocation);
+        let (after_creation, Some((working_set, after))) = read(pid, true).expect("final counters")
+        else {
+            panic!("missing counters")
+        };
+        std::hint::black_box(&allocation);
+        assert_eq!(after_creation, creation);
+        assert!(working_set >= 32 * 1024 * 1024);
+        assert!(after >= before + 24 * 1024 * 1024);
+        assert!(read(0, true).is_none());
+    }
+}
