# Copy to repo-local .env (gitignored). Empty = unset; secrets stay empty; optional unless a command you run needs it.
# Secrets stay empty. See docs/installation.md and README Gemini section.

# Cloud / local model
GEMINI_API_KEY=
OLLAMA_CLOUD_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=

# Ask provider slots (optional)
LEDGERFUL_ASK_PROVIDER_1=
LEDGERFUL_ASK_MODEL_1=

# Daemon / web
LEDGERFUL_WEB_TOKEN=
LEDGERFUL_WEB_PEER_ALLOWLIST=
LEDGERFUL_PARENT_PID=

# State / config
LEDGERFUL_STATE_DIR=
LEDGERFUL_DEFAULT_CONFIG=
LEDGERFUL_CONFIG_HOME=

# Sync / bridge
LEDGERFUL_SYNC_SECRET=
LEDGERFUL_BRIDGE=

# Operator flags
LEDGERFUL_QUIET=
LEDGERFUL_CLOUD_POLICY=
LEDGERFUL_NON_INTERACTIVE=
LEDGERFUL_NO_NETWORK=
LEDGERFUL_NO_TUI=
LEDGERFUL_STRICT_OBSERVE_SIGNAL=
LEDGERFUL_TABLE_STYLE=
